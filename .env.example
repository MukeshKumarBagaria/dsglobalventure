# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.dsglobalventures.com

# Enquiry email delivery (server-only)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="DS Global Ventures <enquiries@yourdomain.com>"

# Supabase — chemical prices (/chemical-prices, /admin/prices). See supabase/schema.sql.
# The publishable key is safe in the browser: writes are limited to price_admins by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
